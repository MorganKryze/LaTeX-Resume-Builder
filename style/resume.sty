\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}[2026/04/24 v1.0 Resume style package]

%------------PACKAGES----------
\RequirePackage{latexsym}
% T1 + Latin Modern: same look as default Computer Modern but with proper
% ToUnicode CMap, so f-ligatures decompose to "ff"/"fi"/"fl" on text
% extraction. See docs/ATS.md.
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[default]{sourcesanspro}
\RequirePackage[empty]{fullpage}
\RequirePackage{titlesec}
\RequirePackage{marvosym}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{verbatim}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{fancyhdr}
\RequirePackage[english]{babel}
\RequirePackage{tabularx}
\RequirePackage{iftex}
% pdfTeX-only ATS Unicode mappings; XeTeX/LuaTeX do not define these primitives.
\ifPDFTeX
\input{glyphtounicode}
\fi
%------------------------------

%-----------ACCENT COLOR-------
% User-configurable accent color for section rules and hyperlinks.
% Default is black (visually identical to v1.1.x with [hidelinks] hyperref).
%
% The accent is sourced from options.yml's `accent_color: [R, G, B]` and
% piped in by scripts/write_accent.py, which writes a one-line
% `_accent.tex` next to each declared resume source. resume.sty inputs
% that file when present; with no such file the default below applies.
%
% You can also override directly in your content's preamble, e.g.:
%   \definecolor{resumeAccent}{HTML}{0F3778}
\definecolor{resumeAccent}{HTML}{000000}
\IfFileExists{_accent.tex}{\input{_accent.tex}}{}
\hypersetup{
  colorlinks=true,
  urlcolor=resumeAccent,
  linkcolor=resumeAccent,
  citecolor=resumeAccent,
  pdfborder={0 0 0}
}
%-------------------------------

%----------FORMATTING-----------
\setlength{\footskip}{5pt}
\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
%-------------------------------

%-----------MARGINS-------------
\addtolength{\oddsidemargin}{-0.65in}
\addtolength{\evensidemargin}{-0.65in}
\addtolength{\textwidth}{1.3in}
\addtolength{\topmargin}{-.8in}
\addtolength{\textheight}{1.5in}
%-------------------------------

%----------GENERAL-----------
\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
% Title + horizontal rule on the SAME line (rule fills to right margin)
\newcommand{\sectionrule}[1]{#1\hspace{0.5em}{\color{resumeAccent}\hrulefill}}
\titleformat{\section}{
  \vspace{-4pt}\raggedright\large\bfseries
}{}{0em}{\sectionrule}[\vspace{-5pt}]

% Ensure generated pdf is machine readable / ATS parsable
\ifPDFTeX
\pdfgentounicode=1
\fi
%-------------------------------

%-----------COMMANDS------------
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}
%-------------------------------

\endinput
